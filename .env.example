# World ID (get from https://developer.worldcoin.org)
NEXT_PUBLIC_WORLD_APP_ID=app_your_app_id
WORLD_APP_ID=app_your_app_id
WORLD_DEV_PORTAL_API_KEY=your_api_key

# World ID v4 RP signing (from Developer Portal > World ID 4.0)
RP_ID=rp_your_rp_id
RP_SIGNING_KEY=0xyour_64_hex_char_private_key

# Session secret (generate a random 32+ char string)
SESSION_SECRET=change-me-to-a-random-string

# Database (SQLite for local, PostgreSQL URL for production)
DATABASE_URL="file:./dev.db"
